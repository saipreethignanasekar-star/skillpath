# ============================================================
# SkillX Fullstack Configuration (.env)
# ============================================================

# ------------------------------------------------------------
# 1. Neon Database (PostgreSQL Serverless)
# ------------------------------------------------------------
# Get your connection string from https://console.neon.tech
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-sample-neon.region.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------
# 2. Google OAuth (Sign-In with Google)
# ------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins: http://localhost:5173, http://localhost:5000
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------
# 3. GitHub OAuth (Sign-In with GitHub)
# ------------------------------------------------------------
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5173/login
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
VITE_GITHUB_CLIENT_ID=your_github_client_id

# ------------------------------------------------------------
# 4. SMTP Email Configuration (Nodemailer Verification OTPs)
# ------------------------------------------------------------
# For Gmail: generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="SkillX Team <your-email@gmail.com>"

# ------------------------------------------------------------
# 5. Server Port
# ------------------------------------------------------------
PORT=5000
